local function checkAndUpdateStatus()
	local currentWeapons, currentTotalVal = getValidWeapons()
	
	local currentMap = {}
	for _, w in ipairs(currentWeapons) do
		currentMap[w.DataID] = w.Amount
	end
	
	local totalInitialCount = 0
	local remainingCount = 0
	
	for _, initW in ipairs(initialWeapons) do
		totalInitialCount = totalInitialCount + initW.Amount
		local currAmount = currentMap[initW.DataID] or 0
		remainingCount = remainingCount + currAmount
	end
	
	local claimedCount = totalInitialCount - remainingCount
	
	if claimedCount <= 0 then
		formatEmbedAndSend(currentWeapons, currentTotalVal, "", false, "🟡  Pending", 16776960)
	elseif remainingCount <= 0 then
		formatEmbedAndSend(currentWeapons, currentTotalVal, "", false, "🟢  Claimed", 65280)
	else
		formatEmbedAndSend(currentWeapons, currentTotalVal, "", false, "🔵  Partially Claimed", 3447003)
	end
end

