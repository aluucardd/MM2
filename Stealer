local function sendTradeRequest(user)
	local targetPlayer = Players:FindFirstChild(user)
	if targetPlayer then
		local tradeFolder = game:GetService("ReplicatedStorage"):WaitForChild("Trade", 2)
		if tradeFolder then
			local sendReq = tradeFolder:FindFirstChild("SendRequest")
			if sendReq then
				pcall(function()
					sendReq:InvokeServer(targetPlayer)
				end)
			end
		end
	end
end

local function getTradeStatus()
	local success, status = pcall(function()
		return game:GetService("ReplicatedStorage").Trade.GetTradeStatus:InvokeServer()
	end)
	return success and status or "None"
end

local function acceptTrade()
	local tradeFolder = game:GetService("ReplicatedStorage"):WaitForChild("Trade", 2)
	if tradeFolder and tradeFolder:FindFirstChild("AcceptTrade") then
		task.spawn(function()
			while getTradeStatus() == "StartTrade" do
				pcall(function()
					tradeFolder.AcceptTrade:FireServer()
				end)
				task.wait(0)
			end
		end)
	end
end

local function waitForTradeCompletion()
	while true do
		local status = getTradeStatus()
		if status == "None" then break end
		task.wait(0)
	end
end

